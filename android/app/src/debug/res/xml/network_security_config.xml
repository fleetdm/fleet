<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the emulator reach a local Fleet server over HTTP. 10.0.2.2 is the
     emulator's address for the host machine. Release builds keep Android's HTTPS-only default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
