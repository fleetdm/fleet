#!/bin/sh
# Prevent commits whose message contains disallowed co-author trailers
MSG_FILE="$1"
if grep -Eiq '^Co-authored-by:[[:space:]]*.*(copilot|claude)' "$MSG_FILE"; then
  echo "Commit message contains a disallowed Co-authored-by trailer (copilot/claude). Please remove it." >&2
  exit 1
else
  status=$?
  if [ "$status" -gt 1 ]; then
    echo "Unable to inspect the commit message." >&2
    exit "$status"
  fi
fi
exit 0
