<div id="integrations" v-cloak>
  <div purpose="page-container">
    <div purpose="page-content">

      <div purpose="page-hero">
        <div purpose="hero-text">
          <h4>Integrations</h4>
          <h1>Extend Fleet</h1>
          <p>Integrate AI coding agents, ticketing systems, data lakes (/SIEMs), no-code (/SOAR) platforms, configuration management tools, network appliances for asset discovery, and more.</p>
          <p>You can also build custom workflows with the REST API, webhook events, and fleetctl command line tool.</p>
          <div purpose="button-row">
            <a purpose="cta-button" href="/contact?talkToUs">Get a demo</a>
            <animated-arrow-button href="/docs/rest-api/rest-api">Explore the REST API</animated-arrow-button>
          </div>
        </div>
        <%
          // Positions are in the hub's 520×460 coordinate space, so the SVG lines and the HTML nodes line up at any size.
          let hubWidth = 520;
          let hubHeight = 460;
          let hubNodes = [];
          aiIntegrations.forEach((integration, index)=>{
            let angle = (45 + index * 90) * Math.PI / 180;
            hubNodes.push({ integration, ring: 'inner', x: hubWidth / 2 + 118 * Math.cos(angle), y: hubHeight / 2 + 118 * Math.sin(angle) });
          });
          ['okta', 'splunk', 'jira', 'snowflake', 'github', 'ansible', 'vanta', 'aws'].forEach((slug, index)=>{
            let angle = (22.5 + index * 45) * Math.PI / 180;
            hubNodes.push({ integration: integrations.find((integration)=> integration.slug === slug), ring: 'outer', x: hubWidth / 2 + 200 * Math.cos(angle), y: hubHeight / 2 + 180 * Math.sin(angle) });
          });
        %>
        <div purpose="hub" aria-hidden="true">
          <svg purpose="hub-lines" viewBox="0 0 <%- hubWidth %> <%- hubHeight %>">
            <ellipse cx="<%- hubWidth / 2 %>" cy="<%- hubHeight / 2 %>" rx="118" ry="118" purpose="hub-ring"/>
            <ellipse cx="<%- hubWidth / 2 %>" cy="<%- hubHeight / 2 %>" rx="200" ry="180" purpose="hub-ring"/>
            <% for (let node of hubNodes) { %>
            <line x1="<%- node.x.toFixed(1) %>" y1="<%- node.y.toFixed(1) %>" x2="<%- hubWidth / 2 %>" y2="<%- hubHeight / 2 %>" purpose="hub-line" ring="<%- node.ring %>"/>
            <% } %>
          </svg>
          <div purpose="hub-center">
            <img src="/images/icon-fleet-avatar-28x28.svg" alt="">
          </div>
          <% hubNodes.forEach((node, index)=>{ %>
          <div purpose="hub-node" ring="<%- node.ring %>" style="left: <%- (node.x / hubWidth * 100).toFixed(2) %>%; top: <%- (node.y / hubHeight * 100).toFixed(2) %>%; animation-delay: -<%- index * 0.7 %>s;">
            <img src="<%- node.integration.logo %>" alt="">
          </div>
          <% }); %>
        </div>
      </div>

      <div purpose="ai-section">
        <div purpose="section-heading">
          <h4>AI-native device management</h4>
          <h2>Use the AI you already trust</h2>
          <p>Fleet works natively with your team’s AI tools, like Claude, Copilot, or any AI harness. Use it to propose changes, with a human review between it and your devices.</p>
        </div>
        <ai-tool-graphic :include-teams="true" :platform="visitorPlatform" :initial-tool="visitorPlatform === 'windows' ? 'teams' : 'slack'"></ai-tool-graphic>
        <div purpose="ai-tools">
          <% for (let integration of aiIntegrations) { %>
          <div purpose="ai-tool">
            <div purpose="ai-tool-heading">
              <img src="<%- integration.logo %>" alt="<%- integration.name %> logo">
              <h5><%- integration.name %></h5>
            </div>
            <p><%- integration.summary %></p>
            <animated-arrow-button href="<%- integration.docsUrl %>" target="<%- integration.docsUrl.startsWith('http') ? '_blank' : '_self' %>"><%- integration.docsLabel %></animated-arrow-button>
          </div>
          <% } %>
        </div>
      </div>

      <div purpose="directory">
        <div purpose="directory-toolbar">
          <div purpose="directory-heading">
            <h2>All integrations</h2>
            <div purpose="search">
              <img src="/images/icon-search-16x16@2x.png" alt="">
              <input type="text" v-model="searchQuery" placeholder="Search integrations" aria-label="Search integrations">
            </div>
          </div>
          <div purpose="category-filters">
            <button purpose="category-filter" :class="{selected: selectedCategory === 'all'}" @click="clickSelectCategory('all')">All</button>
            <% for (let category of integrationCategories) { %>
            <button purpose="category-filter" :class="{selected: selectedCategory === '<%- category.slug %>'}" @click="clickSelectCategory('<%- category.slug %>')"><%- category.shortName %></button>
            <% } %>
          </div>
        </div>

        <% for (let category of integrationCategories) { %>
        <div purpose="category-section" v-if="countVisibleIntegrations('<%- category.slug %>') > 0">
          <div purpose="category-heading">
            <h3><%- category.name %></h3>
            <span>{{countVisibleIntegrations('<%- category.slug %>')}}</span>
          </div>
          <div purpose="integration-grid">
            <% for (let integration of integrations.filter((integration)=> integration.category === category.slug)) { %>
            <div purpose="integration-card" v-if="isIntegrationVisible('<%- integration.slug %>')">
              <a purpose="card-link" href="<%- integration.docsUrl || integration.learnMoreUrl %>" target="<%- (integration.docsUrl || integration.learnMoreUrl).startsWith('http') ? '_blank' : '_self' %>" no-icon aria-label="<%- integration.name %>"></a>
              <div purpose="integration-logo" class="<%- integration.logoType === 'icon' ? 'with-name' : '' %>">
                <img src="<%- integration.logo %>" alt="<%- integration.name %> logo">
                <% if (integration.logoType === 'icon') { %><span><%- integration.name %></span><% } %>
              </div>
              <p><%- integration.summary %></p>
              <div purpose="integration-links">
                <% if (integration.docsUrl) { %>
                <animated-arrow-button href="<%- integration.docsUrl %>" target="<%- integration.docsUrl.startsWith('http') ? '_blank' : '_self' %>"><%- integration.docsLabel %></animated-arrow-button>
                <% } %>
                <a purpose="learn-more-link" href="<%- integration.learnMoreUrl %>" target="_blank">Learn more</a>
              </div>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>
        <div purpose="no-results" v-if="countVisibleIntegrations() === 0">
          <p>No integrations match “{{searchQuery}}”.</p>
          <button purpose="clear-filters-button" @click="clickClearFilters()">Clear filters</button>
        </div>
      </div>

      <div purpose="build-section">
        <div purpose="section-heading">
          <h2>Build anything</h2>
          <p>Configure custom IdPs, trigger automations with webhooks, or build custom dashboards using Fleet’s REST API.</p>
        </div>
        <div purpose="build-grid">
          <% for (let block of buildingBlocks) { %>
          <div purpose="build-card">
            <a purpose="card-link" href="<%- block.docsUrl %>" aria-label="<%- block.name %> docs"></a>
            <div purpose="build-card-heading">
              <img src="<%- block.logo %>" alt="">
              <h5><%- block.name %></h5>
            </div>
            <p><%- block.description %></p>
            <animated-arrow-button href="<%- block.docsUrl %>">Docs</animated-arrow-button>
          </div>
          <% } %>
        </div>
      </div>

      <div purpose="bottom-cta">
        <h2>Build integrations that connect your product with Fleet</h2>
        <div purpose="button-row">
          <a purpose="cta-button" href="/partners">Become a technology partner</a>
          <animated-arrow-button href="/contact?talkToUs">Get a demo</animated-arrow-button>
        </div>
      </div>

    </div>
  </div>
  <cloud-city></cloud-city>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
