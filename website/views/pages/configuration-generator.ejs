<div id="configuration-generator" v-cloak>
  <div purpose="page-container">
    <div purpose="page-content">
      <div purpose="page-headline">
        <h1>Configuration robot 🤖</h1>
        <p>Generate OS settings in DDM, CSP, and .mobileconfig format.</p>
      </div>
      <div v-if="!hasGeneratedProfile || cloudError">
        <div purpose="modal-form">
        <ajax-form :handle-submitting="handleSubmittingForm" :cloud-error.sync="cloudError" :form-errors.sync="formErrors" :form-data="formData" :form-rules="formRules">
          <div class="d-flex flex-row align-items-center mb-3">
            <img style="height: 24px;" alt="Generate a configuration profile" src="/images/icon-generate-14x14@2x.png">
            <p class="mb-0 ml-2"><strong>What would you like to happen?</strong></p>
          </div>
          <div class="form-group">
            <label for="profile-type">
              Format
            </label>
            <select class="form-control" style="color: #515774;" purpose="profile-type-selector" id="profile-type" :class="[formErrors.profileType ? 'is-invalid' : '']" v-model.trim="formData.profileType">
              <option value="ddm">DDM (macOS)</option>
              <option value="mobileconfig">.mobileconfig (macOS)</option>
              <option value="csp">CSP (Windows)</option>
            </select>
            <div class="invalid-feedback" v-if="formErrors.profileType" focus-first>Select the type of profile that you want to generate.</div>
          </div>
          <div class="form-group">
            <label for="profile">Instructions</label>
            <textarea class="form-control" type="textarea" id="profile" placeholder="Disable camera access in Firefox" :class="[formErrors.naturalLanguageInstructions ? 'is-invalid' : '']" v-model.trim="formData.naturalLanguageInstructions"></textarea>
            <div class="invalid-feedback" v-if="formErrors.naturalLanguageInstructions" focus-first>Please provide instructions.</div>
          </div>
          <p v-if="cloudError && cloudErrorExplanation" class="text-danger">Your request could not be processed. {{cloudErrorExplanation}}</p>
          <p v-else-if="cloudError" class="text-danger">Your request could not be processed. Please try again.</p>
          <ajax-button purpose="submit-button" spinner="true" type="submit" :syncing="syncing" class="btn btn-primary mt-4">Generate</ajax-button>
        </ajax-form>
      </div>
      </div>
      <div v-show="hasGeneratedProfile && !cloudError">
        <div class="d-flex flex-column-reverse mb-4">
          <p v-if="cloudError && cloudErrorExplanation" class="text-danger">Your request could not be processed. {{cloudErrorExplanation}}</p>
          <p v-else-if="cloudError" class="text-danger">Your request could not be processed. Please try again.</p>
          <div purpose="profile-editor">
            <div id="editor" @paste="getUpdatedValueFromEditor" @input="getUpdatedValueFromEditor" purpose="ace-editor"  mode="xml" :value.sync="generatedOutput"></div>

            <div purpose="generate-button" @click="clickEditGeneratedOutput()" v-if="!hideEditButton && !syncing"><i class="p-3 fa fa-pencil"></i></div>

            <div purpose="pending-profile" v-if="syncing">
              <p class="mb-0">Writing the profile</p>
              <span purpose="loading-indicator">
                <span class="loading-dot dot1"></span>
                <span class="loading-dot dot2"></span>
                <span class="loading-dot dot3"></span>
                <span class="loading-dot dot4"></span>
              </span>
            </div>
          </div>
          <div purpose="enforced-settings" class="mb-3" v-if="parsedItemsInProfile.length || anticipatedItemsInProfile.length">
            <p v-if="parsedItemsInProfile.length"><strong>Settings enforced:</strong></p>
            <p v-else><strong>Settings this profile will probably enforce:</strong></p>
            <div v-for="item in (parsedItemsInProfile.length ? parsedItemsInProfile : anticipatedItemsInProfile)">
              <p>{{item.name}}: {{item.value}}</p>
            </div>
            <p v-if="deliveryNotes"><strong>Deployment note:</strong> {{deliveryNotes}}</p>
          </div>
        </div>
        <p v-if="!syncing"><a @click="clickDownloadResult()">Download</a> this profile and deploy it using Fleet, Jamf, Intune or Airwatch.</p>
      </div>
    </div>
  </div>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
