<div id="pharma" v-cloak>
  <div purpose="page-container">
    <div purpose="page-content">

      <div purpose="page-hero">
        <div purpose="page-heading">
          <h4>Pharma 4.0</h4>
          <h1>Spend your time on the next breakthrough, not the last patch</h1>
        </div>
        <div purpose="hero-text">
          <p>Your plants check quality continuously. Fleet does the same for every Mac, iPad, and PC, so your team can focus on what's next.</p>
        </div>
        <div purpose="button-row">
          <a purpose="cta-button" href="/contact?talkToUs">Get a demo</a>
          <animated-arrow-button href="/case-study/abridge">Read the Abridge story</animated-arrow-button>
        </div>
      </div>

      <div purpose="page-section">
        <div purpose="section-heading">
          <h2>Most device management still runs in batches</h2>
        </div>
        <div purpose="pain-cards">
          <div purpose="pain-card">
            <h5>Patches wait for the next window</h5>
            <p>Every update feels like it needs revalidation, so they pile up while deadlines get shorter.</p>
          </div>
          <div purpose="pain-card">
            <h5>Every change means paperwork</h5>
            <p>The request, the work, and the proof live in different places. Audit prep takes weeks.</p>
          </div>
          <div purpose="pain-card">
            <h5>AI arrived before the policy did</h5>
            <p>People install AI tools on their own, and each one can reach research data.</p>
          </div>
        </div>
      </div>

      <div purpose="feature-with-image">
        <div purpose="feature-image">
          <img alt="Self-service software in Fleet Desktop" src="/images/feature-image-self-service-800x600@2x.png">
        </div>
        <div purpose="feature-text">
          <h2>Streamline the fundamentals. Focus on the future.</h2>
          <p>One platform for Apple, Windows, and Linux. When the basics run themselves, IT has time for what's next.</p>
          <div purpose="stats">
            <div purpose="stat">
              <h3>50–80%</h3>
              <p>Less time spent on maintenance</p>
            </div>
            <div purpose="stat">
              <h3>99%</h3>
              <p>Fewer tickets and errors during new hire onboarding</p>
            </div>
          </div>
        </div>
      </div>

      <div purpose="quote-section">
        <p purpose="quote-text">“As it evolved and we learned more about Fleet, we just decided… we're going to move all of our device types to Fleet.”</p>
        <div purpose="quote-author-info">
          <div purpose="name-and-title">
            <p purpose="author-name">Director of IT Infrastructure</p>
            <p purpose="author-title">Leading life sciences cloud software company</p>
          </div>
        </div>
      </div>

      <div purpose="feature-with-image" class="reverse">
        <div purpose="feature-image">
          <img alt="An AI-drafted change to enforce approved AI tools, reviewed and approved as a pull request" src="/images/ai-assisted-it-feature-image-800x600@2x.png">
        </div>
        <div purpose="feature-text">
          <h2>AI does the work. Every change gets a batch record.</h2>
          <p>AI drafts the change. A person approves it. Fleet records who, what, and when, so the proof is ready before the inspector asks.</p>
        </div>
      </div>

      <div purpose="quote-and-logos">
        <div purpose="section-quote">
          <div purpose="quote-author-image">
            <img alt="Gabe Chan" src="/images/gabe-chan-120x120@2x.png">
          </div>
          <div purpose="quote-content">
            <p purpose="quote-text">“MDM isn't new, but many legacy tools aren't keeping up. You have to choose something nimble enough to move at that speed.”</p>
            <div purpose="name-and-title">
              <p purpose="author-name">Gabe Chan</p>
              <p purpose="author-title">Staff IT Engineer, Abridge</p>
            </div>
          </div>
        </div>
        <div purpose="logo-grid">
          <div purpose="logo"><img alt="Abridge logo" src="/images/logos/logo-abridge-133x32@2x.png"></div>
          <div purpose="logo"><img alt="NVIDIA logo" src="/images/logos/logo-nvidia-color-161x32@2x.png"></div>
          <div purpose="logo"><img alt="Fastly logo" src="/images/logos/logo-fastly-color-70x28@2x.png"></div>
          <div purpose="logo"><img alt="Rivian logo" src="/images/logos/logo-rivian-color-200x40@2x.png"></div>
          <div purpose="logo"><img alt="Leidos logo" src="/images/logos/logo-leidos-color-84x20@2x.png"></div>
          <div purpose="logo"><img alt="Nutanix logo" src="/images/logos/logo-nutanix-color-93x12@2x.png"></div>
        </div>
      </div>

      <div purpose="feature-with-image">
        <div purpose="feature-image">
          <img alt="A policy automation in Fleet that installs software to fix failing devices" src="/images/feature-image-stop-chasing-patches-800x600@2x.png">
        </div>
        <div purpose="feature-text">
          <h2>Patch continuously, not quarterly</h2>
          <p>Fleet keeps every app and operating system current, on a schedule you control.</p>
          <div purpose="stats">
            <div purpose="stat">
              <h3>1400+</h3>
              <p>Apps packaged and patched for you</p>
            </div>
            <div purpose="stat">
              <h3>2–3 min</h3>
              <p>To answer security questions during an incident, down from 30 (Abridge)</p>
            </div>
          </div>
        </div>
      </div>

      <div purpose="trust-cards">
        <div purpose="trust-card">
          <div purpose="trust-card-text">
            <h5>SOC 2 Type II audited</h5>
            <p>Controls, policies, and pen test results, ready for supplier qualification.</p>
          </div>
          <a purpose="cta-button" href="https://trust.fleetdm.com" target="_blank" no-icon>Visit trust center</a>
        </div>
      </div>

      <div purpose="bottom-cta">
        <div purpose="page-heading">
          <h4>Pharma 4.0</h4>
          <h1>Device management, from batch to continuous</h1>
        </div>
        <div purpose="button-row">
          <a purpose="cta-button" href="/contact?talkToUs">Get a demo</a>
          <animated-arrow-button href="/fast-track">Explore Fast Track</animated-arrow-button>
        </div>
      </div>

    </div>
  </div>
  <cloud-city></cloud-city>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
