<div id="admin-hire" v-cloak>
  <div purpose="page-container">

    <h1>Job board</h1>
    <p>Post roles at Fleet customers to <a href="/hire" target="_blank">fleetdm.com/hire</a>, and verify the people who want to be introduced. Only Fleet team members can see this page.</p>

    <div purpose="section">
      <h2>Post a role</h2>
      <div class="card card-body" purpose="form">
        <ajax-form :syncing.sync="syncing" :cloud-error.sync="cloudError" :form-errors.sync="formErrors" :form-data="formData" :form-rules="formRules" :handle-submitting="handleSubmittingJobPostingForm" @submitted="submittedJobPostingForm($event)">

          <div class="form-group" purpose="company-autocomplete">
            <label for="companyName">Company</label>
            <input class="form-control" id="companyName" type="text" autocomplete="off" placeholder="Start typing to search Salesforce" :class="[formErrors.companyName ? 'is-invalid' : '']" v-model="formData.companyName" @input="typeCompanyName()" @blur="blurCompanyName()">
            <div purpose="autocomplete-results" v-if="showCompanySuggestions && companySuggestions.length > 0">
              <a purpose="autocomplete-result" v-for="account in companySuggestions" :key="account.salesforceAccountId" @mousedown.prevent="clickSelectCompany(account)">
                <strong>{{account.name}}</strong>
                <span v-if="account.type"> · {{account.type}}</span>
                <span v-if="account.website"> · {{account.website}}</span>
              </a>
            </div>
            <small purpose="company-hint" v-if="formData.salesforceAccountId">Linked to Salesforce account {{formData.salesforceAccountId}}</small>
            <small purpose="company-hint" v-else-if="formData.companyName">Not linked to a Salesforce account</small>
            <div class="invalid-feedback" v-if="formErrors.companyName">Please enter the hiring company.</div>
          </div>

          <div class="form-group">
            <label for="title">Job title</label>
            <input class="form-control" id="title" type="text" placeholder="Senior Client Platform Engineer" :class="[formErrors.title ? 'is-invalid' : '']" v-model.trim="formData.title">
            <div class="invalid-feedback" v-if="formErrors.title">Please enter a job title.</div>
          </div>

          <div class="form-group">
            <label for="role">Role</label>
            <select class="form-control" id="role" :class="[formErrors.role ? 'is-invalid' : '']" v-model="formData.role">
              <option value="" disabled>Choose a role</option>
              <option v-for="role in jobBoardRoles" :key="role" :value="role">{{role}}</option>
            </select>
            <div class="invalid-feedback" v-if="formErrors.role">Please choose a role.</div>
          </div>

          <div class="form-group">
            <label for="location">Location (optional)</label>
            <input class="form-control" id="location" type="text" placeholder="Remote (US)" v-model.trim="formData.location">
          </div>

          <div class="form-group">
            <label for="description">Description (optional)</label>
            <textarea class="form-control" id="description" rows="4" v-model.trim="formData.description"></textarea>
          </div>

          <cloud-error purpose="cloud-error" v-if="cloudError"></cloud-error>
          <ajax-button purpose="submit-button" spinner="true" :syncing="syncing" class="btn btn-primary">Post role</ajax-button>
        </ajax-form>
      </div>
    </div>

    <div purpose="section">
      <h2>Roles</h2>
      <div purpose="table-container" v-if="jobPostings.length > 0">
        <table class="table">
          <thead><tr>
            <td>Role</td>
            <td>Company</td>
            <td>Interested</td>
            <td>Posted</td>
            <td></td>
          </tr></thead>
          <tbody>
            <tr v-for="jobPosting in jobPostings" :key="jobPosting.id" :class="[jobPosting.isOpen ? '' : 'closed']">
              <td>{{jobPosting.title}}<br><small>{{jobPosting.role}}<span v-if="jobPosting.location"> · {{jobPosting.location}}</span></small></td>
              <td>{{jobPosting.companyName}}<br><small v-if="jobPosting.salesforceAccountId"><a :href="'https://fleetdm.lightning.force.com/lightning/r/Account/'+jobPosting.salesforceAccountId+'/view'" target="_blank">Salesforce</a></small></td>
              <td>{{(jobPosting.interestedJobSeekers || []).length}}</td>
              <td><js-timestamp format="calendar" :at="jobPosting.createdAt"></js-timestamp></td>
              <td>
                <ajax-button class="btn btn-sm btn-outline-secondary" :syncing="syncing" @click="clickToggleJobPosting(jobPosting)">{{jobPosting.isOpen ? 'Close' : 'Reopen'}}</ajax-button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p v-else>No roles posted yet.</p>
    </div>

    <div purpose="section">
      <h2>Job seekers</h2>
      <p>Verify each person's claim before introducing them. The Salesforce note shows what we found for their fleetdm.com email address when they joined. It's a hint, not proof, since fleetdm.com doesn't verify email addresses.</p>
      <div purpose="table-container" v-if="jobSeekers.length > 0">
        <table class="table">
          <thead><tr>
            <td>Person</td>
            <td>Looking for</td>
            <td>Claim</td>
            <td>Interested in</td>
            <td>Status</td>
          </tr></thead>
          <tbody>
            <tr v-for="jobSeeker in jobSeekers" :key="jobSeeker.id">
              <td>
                {{jobSeeker.user.firstName}} {{jobSeeker.user.lastName}}<br>
                <small><a :href="'mailto:'+jobSeeker.user.emailAddress">{{jobSeeker.user.emailAddress}}</a></small><br>
                <small v-if="jobSeeker.linkedinUrl"><a :href="jobSeeker.linkedinUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a></small>
                <small purpose="notes" v-if="jobSeeker.notes"><br>{{jobSeeker.notes}}</small>
              </td>
              <td><small>{{(jobSeeker.rolesSought || []).join(', ')}}</small></td>
              <td>
                {{jobSeeker.eligibilityReason}}<br>
                <small>{{jobSeeker.eligibilityDetails}}</small><br>
                <small purpose="crm-hint">Salesforce: {{jobSeeker.crmMatchSummary || 'n/a'}}</small>
              </td>
              <td><small v-for="jobPosting in jobSeeker.interestedInJobPostings" :key="jobPosting.id">{{jobPosting.title}} at {{jobPosting.companyName}}<br></small></td>
              <td>
                <select class="form-control form-control-sm" :value="jobSeeker.verificationStatus" :disabled="syncing" @change="changeVerificationStatus(jobSeeker, $event.target.value)">
                  <option v-for="verificationStatus in ['Pending', 'Verified', 'Not eligible']" :key="verificationStatus" :value="verificationStatus">{{verificationStatus}}</option>
                </select>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p v-else>No one is on the list yet.</p>
    </div>

  </div>
</div>
<%- /* Expose server-rendered data as window.SAILS_LOCALS :: */ exposeLocalsToBrowser() %>
