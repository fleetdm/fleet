<pre aria-hidden="true"><span purpose="code-comment"># fleet.yml</span>
controls:
  macos_settings:
    custom_settings:
<span purpose="code-value">      - path: ./profiles/disk-encryption.mobileconfig</span>
  macos_updates:
<span purpose="code-value">    minimum_version: "15.5"
