            <cloud-error class="p-0 mt-1 mb-0 bg-transparent" v-if="heroCloudError && heroCloudError !== 'invalidEmailDomain'"></cloud-error>
          </div>
          <ajax-button purpose="hero-email-button" type="submit" syncing-message="Looking up availability…" :syncing="syncing" class="btn btn-primary">Get a demo</ajax-button>
        </ajax-form>
      </div>
      <ai-tool-graphic></ai-tool-graphic>
