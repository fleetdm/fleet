            <div>
              <h4>Omarchy Linux management</h4>
              <h1>Omakase for your desktop,<br> full control for your fleet.</h1>
            </div>
            <div purpose="button-row" class="d-flex justify-content-center align-items-center mx-auto">
              <a purpose="cta-button" class="btn btn-primary" href="/docs">Read the docs</a>
              <animated-arrow-button href="/pricing">View pricing</animated-arrow-button>
