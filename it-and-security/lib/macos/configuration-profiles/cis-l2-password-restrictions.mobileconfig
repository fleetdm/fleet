<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDescription</key>
	<string>Enforces the CIS Apple macOS Benchmark section 5.2 password restrictions (Level 1 and Level 2): lockout threshold, minimum length, alphabetic, numeric, special, and mixed-case complexity, maximum age, and history.</string>
	<key>PayloadDisplayName</key>
	<string>CIS Level 2 password restrictions</string>
	<key>PayloadIdentifier</key>
	<string>com.fleetdm.cis-l2-password-restrictions</string>
	<key>PayloadOrganization</key>
	<string>Fleet Device Management</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>adf39e42-3b3b-4be6-9b50-8ad72f6757c0</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>TargetDeviceType</key>
	<integer>5</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>CIS Level 2 password restrictions</string>
			<key>PayloadIdentifier</key>
			<string>com.fleetdm.cis-l2-password-restrictions.passwordpolicy</string>
			<key>PayloadType</key>
			<string>com.apple.mobiledevice.passwordpolicy</string>
			<key>PayloadUUID</key>
			<string>a422f390-5add-4bb8-ba90-2106c8ffe66b</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<!-- CIS 5.2.1: lock the account after 5 failed attempts (Apple range 2-11). -->
			<key>maxFailedAttempts</key>
			<integer>5</integer>
			<!-- Not a CIS control: automatically unlock after 15 minutes so a typo-lockout does not strand a test Mac. Requires maxFailedAttempts. -->
			<key>minutesUntilFailedLoginReset</key>
			<integer>15</integer>
			<!-- CIS 5.2.2: minimum length of 15 characters (Apple range 0-16). -->
			<key>minLength</key>
			<integer>15</integer>
			<!-- CIS 5.2.3 and 5.2.4: require alphabetic and numeric characters. -->
			<key>requireAlphanumeric</key>
			<true/>
			<!-- CIS 5.2.5: require at least one special (non-alphanumeric) character (Apple range 0-4). -->
			<key>minComplexChars</key>
			<integer>1</integer>
			<!-- CIS 5.2.6: require upper- and lowercase characters. The payload has no dedicated key, so use customRegex (macOS 14 and later). -->
			<key>customRegex</key>
			<dict>
				<key>passwordContentRegex</key>
				<string>^(?=.*[A-Z])(?=.*[a-z]).*$</string>
				<key>passwordContentDescription</key>
				<dict>
					<key>default</key>
					<string>Must contain at least one uppercase and one lowercase letter.</string>
				</dict>
			</dict>
			<!-- CIS 5.2.7: maximum password age of 365 days (Apple range 1-730). -->
			<key>maxPINAgeInDays</key>
			<integer>365</integer>
			<!-- CIS 5.2.8: do not allow reuse of the last 24 passwords (Apple range 1-50). -->
			<key>pinHistory</key>
			<integer>24</integer>
		</dict>
	</array>
</dict>
</plist>
