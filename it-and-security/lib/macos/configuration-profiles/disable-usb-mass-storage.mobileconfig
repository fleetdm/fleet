<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Restrictions</string>
			<key>PayloadIdentifier</key>
			<string>com.fleetdm.config.usbmassstorage.restrictions.B3166A12-9DE3-4ED2-A6B1-7C8AB3D2D220</string>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadUUID</key>
			<string>B3166A12-9DE3-4ED2-A6B1-7C8AB3D2D220</string>
