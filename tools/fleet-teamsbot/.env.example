# Microsoft Teams (Azure Bot registration)
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
TEAMS_APP_PASSWORD=your-client-secret
TEAMS_APP_TENANT_ID=00000000-0000-0000-0000-000000000000

# GitHub
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=fleetdm/fleet
GITHUB_BASE_BRANCH=main
GITOPS_BASE_PATH=it-and-security
GITHUB_BOT_USERNAME=your-bot-github-username

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-4-6

# HTTP server (Teams messaging endpoint + GitHub webhook)
GITHUB_WEBHOOK_SECRET=your-webhook-secret
PORT=3000

# CI auto-fix (set to false to disable)
GITOPS_CI_CHECK_NAME=fleet-gitops
CI_AUTO_FIX=true

# Fleet MCP Server
FLEET_MCP_URL=http://localhost:8181/sse
FLEET_MCP_AUTH_TOKEN=YOUR_MCP_AUTH_TOKEN
